  "info": {
    "_postman_id": "ac1e8ec2-8d48-4340-a165-ced4d15f66bb",
    "name": "Magic Admin API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Magic Admin REST API provides backend integration endpoints for validating Magic-issued DID tokens, retrieving user metadata, and logging users out. These endpoints back the official Magic Admin SDKs (Node, Python, Go, Ruby, Java, PHP) and require the workspace Secret API Key in the `X-Magic-Secret-Key` header. Endpoint paths were derived from the public Magic Admin JS SDK source (magic-admin-js).\n\nContact Support:\n Name: Magic",
      "type": "text/plain"
    }
  }
