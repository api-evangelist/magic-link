          "name": "Logout a user by issuer",
          "request": {
            "name": "Logout a user by issuer",
            "description": {
              "content": "Invalidates all sessions for the Magic user identified by their issuer DID. The SDK helpers `logoutByPublicAddress` and `logoutByToken` resolve to an issuer and call this endpoint.",
              "type": "text/plain"
            },
            "url": {
