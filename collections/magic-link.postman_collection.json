      "item": [
        {
          "id": "812760fd-db02-432c-9cf8-d635f62caac9",
          "name": "Get user metadata",
          "request": {
            "name": "Get user metadata",
            "description": {
              "content": "Retrieve metadata for a Magic user identified by their issuer DID. The optional `wallet_type` query restricts the wallets returned in the response (e.g. `NONE`, `ETH`, `SOLANA`).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "admin",
                "user"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "issuer",
                  "value": "<string>",
                  "description": "(Required) Magic-issued DID (e.g. `did:ethr:0x...`)"
                },
                {
                  "disabled": false,
                  "key": "wallet_type",
                  "value": "NONE"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "735a79c1-423d-4483-9e85-61955713740b",
              "name": "User metadata",
